# Force LF line endings for deployment-critical files so they stay
# valid inside Linux containers even when cloned on Windows.
docker-entrypoint.sh text eol=lf
deploy/Caddyfile text eol=lf
Dockerfile text eol=lf
docker-compose.yml text eol=lf
mini-services/classroom-service/Dockerfile text eol=lf
Caddyfile text eol=lf
