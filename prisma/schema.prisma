// ============================================================
// Ibsar Academy — Prisma Schema (Phase 1 + 2)
// ============================================================
// Notes:
// - SQLite is used locally; can migrate to PostgreSQL at deployment.
// - Enums are represented as String (SQLite-friendly) with @default.
// - All timestamps stored as ISO DateTime.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------
// Core Account Model
// -----------------------------
model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  phone         String?  @unique
  // role: ADMIN | TEACHER | PARENT | STUDENT
  role          String   @default("PARENT")
  name          String?
  nameAr        String?
  passwordHash  String?
  avatarUrl     String?
  country       String?  // EG, SA, AE, KW, QA, BH, OM, JO, etc.
  city          String?
  preferredLang String   @default("ar")
  emailVerified DateTime?
  phoneVerified DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher Teacher?
  student Student?
  parent  Parent?
  otpCodes OtpCode[]
  notifications Notification[]
  transactions Transaction[]

  @@index([role])
  @@index([phone])
  @@index([email])
}

// -----------------------------
// Teacher profile
// -----------------------------
model Teacher {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String?
  bioAr           String?
  // tracks: comma-separated list e.g. "PROGRAMMING,ROBOTICS,MENTAL_MATH"
  tracks          String   @default("")
  experienceYears Int      @default(0)
  rating          Float    @default(0)
  reviewsCount    Int      @default(0)
  hourlyRateEGP   Int      @default(150)
  hourlyRateUSD   Int      @default(15)
  // status: PENDING | APPROVED | REJECTED | SUSPENDED
  status          String   @default("PENDING")
  videoUrl        String?
  diplomaUrl      String?
  availabilityJson String? // JSON string for weekly availability
  isFeatured      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  courses        Course[]
  sessions       Session[]
  availabilities Availability[]
  progressReports ProgressReport[]

  @@index([status])
  @@index([isFeatured])
}

// -----------------------------
// Student profile (child)
// -----------------------------
model Student {
  id            String   @id @default(cuid())
  userId        String?  @unique // optional login account for older students
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId      String
  parent        Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name          String
  nameAr        String?
  birthDate     DateTime?
  gender        String?  // MALE | FEMALE
  grade         String?  // school grade
  // level per track: JSON string e.g. {"PROGRAMMING":"BEGINNER"}
  levelsJson    String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings        Booking[]
  progressReports ProgressReport[]

  @@index([parentId])
}

// -----------------------------
// Parent profile (family account)
// -----------------------------
model Parent {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  students      Student[]
  transactions  Transaction[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// -----------------------------
// OTP verification codes
// -----------------------------
model OtpCode {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    String   // phone number or email
  channel   String   // SMS | EMAIL
  codeHash  String   // hashed OTP code
  purpose   String   // REGISTER | LOGIN | RESET
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([target, purpose])
  @@index([expiresAt])
}

// -----------------------------
// Generic notification log (used from Phase 1 for OTP delivery)
// -----------------------------
model NotificationLog {
  id        String   @id @default(cuid())
  userId    String?
  channel   String   // SMS | EMAIL | PUSH
  to        String
  subject   String?
  body      String
  status    String   @default("PENDING") // PENDING | SENT | FAILED
  error     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

// ============================================================
// Phase 2 models
// ============================================================

// -----------------------------
// Course — a bookable learning package
// -----------------------------
model Course {
  id            String   @id @default(cuid())
  teacherId     String
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  // track: PROGRAMMING | ROBOTICS | MENTAL_MATH
  track         String
  title         String
  titleAr       String?
  description   String?
  descriptionAr String?
  // level: BEGINNER | INTERMEDIATE | ADVANCED
  level         String   @default("BEGINNER")
  ageMin        Int      @default(6)
  ageMax        Int      @default(16)
  totalSessions Int      @default(8)
  sessionDurationMins Int @default(60)
  priceEGP      Int      @default(499)
  priceUSD      Int      @default(29)
  // status: DRAFT | PUBLISHED | ARCHIVED
  status        String   @default("PUBLISHED")
  thumbnailUrl  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]

  @@index([teacherId])
  @@index([track])
  @@index([status])
}

// -----------------------------
// Session — a scheduled class instance
// -----------------------------
model Session {
  id            String   @id @default(cuid())
  courseId      String?
  course        Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacherId     String
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title         String
  // track context (denormalized for quick filtering)
  track         String
  startTime     DateTime
  endTime       DateTime
  durationMins  Int      @default(60)
  // status: SCHEDULED | COMPLETED | CANCELLED | IN_PROGRESS
  status        String   @default("SCHEDULED")
  meetingUrl    String?  // Daily.co room URL (Phase 4)
  recordingUrl  String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings        Booking[]
  progressReports ProgressReport[]

  @@index([teacherId, startTime])
  @@index([status])
  @@index([startTime])
}

// -----------------------------
// Booking — links a student to a session
// -----------------------------
model Booking {
  id            String   @id @default(cuid())
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // status: CONFIRMED | CANCELLED | COMPLETED | NO_SHOW
  status        String   @default("CONFIRMED")
  priceEGP      Int      @default(0)
  priceUSD      Int      @default(0)
  transactionId String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transaction   Transaction? @relation(fields: [transactionId], references: [id])

  @@index([sessionId])
  @@index([studentId])
  @@index([status])
}

// -----------------------------
// Availability — teacher weekly recurring slots
// -----------------------------
model Availability {
  id          String   @id @default(cuid())
  teacherId   String
  teacher     Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  // dayOfWeek: 0 (Sunday) .. 6 (Saturday)
  dayOfWeek   Int
  startHour   Int      // 0-23
  endHour     Int      // 1-24
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([teacherId, dayOfWeek, startHour, endHour])
  @@index([teacherId])
}

// -----------------------------
// Transaction — payment record (Phase 3 will add Escrow/Settlement)
// -----------------------------
model Transaction {
  id            String   @id @default(cuid())
  parentId      String
  parent        Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  // userId for quick lookup (the parent's user)
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  // type: SESSION_BOOKING | PACKAGE | SUBSCRIPTION | REFUND
  type          String   @default("SESSION_BOOKING")
  amountEGP     Int      @default(0)
  amountUSD     Int      @default(0)
  currency      String   @default("EGP")
  // status: PENDING | PAID | FAILED | REFUNDED | SETTLED
  status        String   @default("PENDING")
  // provider: PAYMOB | STRIPE | MANUAL
  provider      String   @default("MANUAL")
  providerRef   String?  // provider transaction id
  description   String?
  bookingId     String?  @unique
  booking       Booking?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([parentId])
  @@index([userId])
  @@index([status])
}

// -----------------------------
// ProgressReport — per-session per-student progress
// -----------------------------
model ProgressReport {
  id            String   @id @default(cuid())
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  // attendance: PRESENT | ABSENT | LATE
  attendance    String   @default("PRESENT")
  // score 0-100
  score         Int      @default(0)
  // skill ratings 1-5
  engagement    Int      @default(3)
  understanding Int      @default(3)
  homework      Int      @default(3)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([teacherId])
}

// -----------------------------
// Notification — in-app notifications
// -----------------------------
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // type: SESSION_REMINDER | BOOKING_CONFIRMED | PAYMENT_RECEIVED | TEACHER_APPROVED | etc.
  type      String
  title     String
  body      String
  // link to navigate when clicked
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

