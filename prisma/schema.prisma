// ============================================================
// Ibsar Academy — Prisma Schema (Phase 1: Foundation)
// ============================================================
// Notes:
// - SQLite is used locally; can migrate to PostgreSQL at deployment.
// - Enums are represented as String (SQLite-friendly) with @default.
// - All timestamps stored as ISO DateTime.
// - Phase 2+ will add: Courses, Sessions, Transactions, Reviews, etc.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------
// Core Account Model
// -----------------------------
model User {
  id            String   @id @default(cuid())
  email         String?  @unique
  phone         String?  @unique
  // role: ADMIN | TEACHER | PARENT | STUDENT
  role          String   @default("PARENT")
  name          String?
  nameAr        String?
  passwordHash  String?
  avatarUrl     String?
  country       String?  // EG, SA, AE, KW, QA, BH, OM, JO, etc.
  city          String?
  preferredLang String   @default("ar")
  emailVerified DateTime?
  phoneVerified DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  teacher Teacher?
  student Student?
  parent  Parent?
  otpCodes OtpCode[]

  @@index([role])
  @@index([phone])
  @@index([email])
}

// -----------------------------
// Teacher profile
// -----------------------------
model Teacher {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String?
  bioAr           String?
  // tracks: comma-separated list e.g. "PROGRAMMING,ROBOTICS,MENTAL_MATH"
  tracks          String   @default("")
  experienceYears Int      @default(0)
  rating          Float    @default(0)
  reviewsCount    Int      @default(0)
  hourlyRateEGP   Int      @default(150)
  hourlyRateUSD   Int      @default(15)
  // status: PENDING | APPROVED | REJECTED | SUSPENDED
  status          String   @default("PENDING")
  videoUrl        String?
  diplomaUrl      String?
  availabilityJson String? // JSON string for weekly availability
  isFeatured      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([isFeatured])
}

// -----------------------------
// Student profile (child)
// -----------------------------
model Student {
  id            String   @id @default(cuid())
  userId        String?  @unique // optional login account for older students
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId      String
  parent        Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name          String
  nameAr        String?
  birthDate     DateTime?
  gender        String?  // MALE | FEMALE
  grade         String?  // school grade
  // level per track: JSON string e.g. {"PROGRAMMING":"BEGINNER"}
  levelsJson    String   @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([parentId])
}

// -----------------------------
// Parent profile (family account)
// -----------------------------
model Parent {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  students      Student[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// -----------------------------
// OTP verification codes
// -----------------------------
model OtpCode {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  target    String   // phone number or email
  channel   String   // SMS | EMAIL
  codeHash  String   // hashed OTP code
  purpose   String   // REGISTER | LOGIN | RESET
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([target, purpose])
  @@index([expiresAt])
}

// -----------------------------
// Generic notification log (used from Phase 1 for OTP delivery)
// -----------------------------
model NotificationLog {
  id        String   @id @default(cuid())
  userId    String?
  channel   String   // SMS | EMAIL | PUSH
  to        String
  subject   String?
  body      String
  status    String   @default("PENDING") // PENDING | SENT | FAILED
  error     String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
}

