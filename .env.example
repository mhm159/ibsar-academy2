# Ibdaa Academy — Environment Variables
# انسخ هذا الملف إلى .env واملأ القيم

# قاعدة البيانات (MySQL محلي)
# ثبّت MySQL ثم أنشئ قاعدة بيانات فارغة باسم ibdaa_academy
# mysql -u root -p -e "CREATE DATABASE ibdaa_academy CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;"
DATABASE_URL="mysql://root:@localhost:3306/ibdaa_academy"

# أسرار الجلسة و OTP (استخدم قيم عشوائية قوية 32+ حرف في الإنتاج)
# ولّدها بـ: openssl rand -hex 32
NEXTAUTH_SECRET="dev-secret-change-me-in-production"
OTP_SECRET="dev-otp-secret-change-me-in-production"

# ====== اختياري — للإنتاج فقط ======

# Twilio (لإرسال SMS + WhatsApp حقيقي عبر OTP)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"  # رقم Twilio WhatsApp

# Resend / SendGrid (لإرسال البريد الحقيقي)
# RESEND_API_KEY=""

# Google OAuth (مرحلة 2)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# PayMob (مرحلة 3 — مصر)
# PAYMOB_API_KEY=""
# PAYMOB_INTEGRATION_ID=""
# PAYMOB_IFRAME_ID=""

# Stripe (مرحلة 3 — خليج)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Daily.co (مرحلة 4 — الغرفة الافتراضية)
# DAILY_API_KEY=""
