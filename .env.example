# Dars Academy (درس) — Environment Variables
# انسخ هذا الملف إلى .env واملأ القيم
# نسخة: 2.0 — Supabase + Ably + PayMob + Stripe

# ============================================================
# قاعدة البيانات — Supabase (PostgreSQL)
# ============================================================
# ملاحظة: إذا كانت كلمة السر تحتوي على رموز خاصة مثل $ / @ #
# يجب ترميزها بـ URL Encoding
DATABASE_URL="postgresql://postgres:your-encoded-password@db.your-project.supabase.co:5432/postgres"

# ============================================================
# الأمان — أسرار الجلسة والـ OTP
# ============================================================
NEXTAUTH_SECRET="generate-a-strong-secret-here-min-32-chars"
OTP_SECRET="generate-a-different-strong-secret-here"
MEDIA_SECRET="generate-another-strong-secret-for-media"

# ============================================================
# الاتصال الفوري — Ably (Real-time classroom)
# ============================================================
ABLY_API_KEY="your-ably-root-api-key.here"

# ============================================================
# رابط الموقع
# ============================================================
NEXT_PUBLIC_APP_URL="https://dars-academy.com"

# ====== اختياري — للإنتاج فقط ======

# ============================================================
# WhatsApp / SMS — Twilio
# ============================================================
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# ============================================================
# البريد الإلكتروني — Resend
# ============================================================
# RESEND_API_KEY=""

# ============================================================
# بوابة الدفع 1 — PayMob (مصر)
# ============================================================
# من: https://dashboard.paymob.com/user/api-keys
# تدعم: فيزا، ماستركارد، فوري، محافظ المحمول، ميزة
# Webhook URL: https://dars-academy.com/api/payment/webhooks/paymob
#
# PAYMOB_API_KEY=""
# PAYMOB_INTEGRATION_ID_CARD=""
# PAYMOB_INTEGRATION_ID_FAWRY=""
# PAYMOB_INTEGRATION_ID_WALLET=""
# PAYMOB_IFRAME_ID=""
# PAYMOB_HMAC_SECRET=""

# ============================================================
# بوابة الدفع 2 — Stripe (الخليج)
# ============================================================
# من: https://dashboard.stripe.com/apikeys
# تدعم: فيزا، ماستركارد، مدى (السعودية)، Apple Pay، STC Pay
# Webhook URL: https://dars-academy.com/api/payment/webhooks/stripe
# Webhook Events: checkout.session.completed, payment_intent.payment_failed
#
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ============================================================
# الفيديو — Daily.co (الغرفة الافتراضية)
# ============================================================
# DAILY_API_KEY=""

# Local testing only. Keep false in production.
PAYMENT_SANDBOX_ENABLED=false
