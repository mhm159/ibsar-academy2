# Manhal Academy — Environment Variables
# انسخ هذا الملف إلى .env واملأ القيم

# قاعدة البيانات (SQLite — افتراضي للتجربة المحلية)
DATABASE_URL="file:./db/custom.db"

# للإنتاج: استخدم MySQL أو PostgreSQL
# DATABASE_URL="mysql://root:@localhost:3306/manhal_academy"
# DATABASE_URL="postgresql://user:pass@localhost:5432/manhal_academy"

# أسرار الجلسة و OTP (استخدم قيم عشوائية قوية 32+ حرف في الإنتاج)
# ولّدها بـ: openssl rand -hex 32
NEXTAUTH_SECRET="dev-secret-change-me-in-production"
OTP_SECRET="dev-otp-secret-change-me-in-production"

# ====== اختياري — للإنتاج فقط ======

# Twilio (لإرسال SMS + WhatsApp حقيقي عبر OTP)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"  # رقم Twilio WhatsApp

# Resend / SendGrid (لإرسال البريد الحقيقي)
# RESEND_API_KEY=""

# Google OAuth (مرحلة 2)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# PayMob (مرحلة 3 — مصر)
# PAYMOB_API_KEY=""
# PAYMOB_INTEGRATION_ID=""
# PAYMOB_IFRAME_ID=""

# Stripe (مرحلة 3 — خليج)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# Daily.co (مرحلة 4 — الغرفة الافتراضية)
# DAILY_API_KEY=""
